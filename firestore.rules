// ═══════════════════════════════════════════════════════════════
// Ministering Assignment Tool — Firestore security rules
//
// Deploy via Firebase Console -> Firestore Database -> Rules -> paste
// this in and Publish (or `firebase deploy --only firestore:rules` if
// you're using the CLI).
//
// Model: four collections.
//   - profiles/{uid}   one doc per user, gates access (mirrors the old
//                       Supabase `profiles` table + admin-approval flow).
//   - wardData/shared  ONE doc holding the entire ward dataset as JSON
//                       (members/households/current/proposed/activityLog)
//                       — the "single shared blob" design, replacing the
//                       old per-table Postgres schema.
//   - threads/{id} (+ messages)  direct messages, readable only by the
//                       people in each conversation.
//   - privateNotes/{id} restricted notes, readable only by the viewers the
//                       author picked.
//
// There's no Cloud Functions trigger here (unlike the old Postgres
// handle_new_user()) — the client creates its own profile doc right
// after signup. Because of that, these rules carry the real security
// weight for signup: a client MUST NOT be able to self-approve or
// self-promote to admin. The `create` rule below enforces that by
// pinning status/isAdmin to exactly what the app would assign, based
// on whether the signup email matches ADMIN_EMAIL.
// ═══════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isApproved() { return isSignedIn() && myProfile().status == 'approved'; }

    // The sign-in account's email has been confirmed through the link Firebase
    // emails at sign-up. Required for the ward data, so an approved account
    // can't be used from an address nobody controls.
    function emailVerified() { return request.auth.token.email_verified == true; }
    function isAdmin()    { return isSignedIn() && myProfile().isAdmin == true; }

    // Keep this in sync with ADMIN_EMAIL in ministering_tool.html.
    function isBootstrapAdminEmail() {
      return request.auth.token.email.lower() == 'micahj145@gmail.com';
    }

    match /profiles/{uid} {
      // You can read your own profile (even while pending/denied, so the
      // app can show you that status) — admins can read everyone's.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Self-registration immediately after signup: only your OWN doc,
      // and only with the exact status/isAdmin the app itself would set
      // (approved+admin only for the designated bootstrap email; pending
      // +non-admin for everyone else). This is what stops a client from
      // signing up and just writing status:'approved' or isAdmin:true.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','firstName','lastName','status','isAdmin','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == (isBootstrapAdminEmail() ? 'approved' : 'pending')
        && request.resource.data.isAdmin == isBootstrapAdminEmail();

      // You may update only your own first/last name — never your own
      // status or isAdmin (that would be self-approval/self-promotion).
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status  == resource.data.status
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.email   == resource.data.email;

      // Admins can update anyone's status/isAdmin (approve/deny/promote).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // The single shared ward-data document. Any approved user has full
    // read/write — same "shared dataset, last-write-wins" model the old
    // Postgres RLS policies used, just collapsed to one document instead
    // of per-row access on five tables.
    match /wardData/shared {
      allow read, write: if isApproved() && emailVerified();
    }

    function canUse() { return isApproved() && emailVerified(); }

    // Unit Statistics tab: ward-level totals imported from LCR reports (no
    // names). Same access as the shared ward data, kept in its own document.
    match /wardData/stats {
      allow read, write: if canUse();
    }

    // ── Direct messages ──────────────────────────────────────────
    // threads/{id}: { participants: [uid], names, createdBy, createdAt, lastAt, lastBy, lastByName }
    // Only the people in a conversation can see it or its messages — this
    // is the actual privacy, not just what the app chooses to show.
    match /threads/{threadId} {
      allow read: if canUse() && request.auth.uid in resource.data.participants;
      allow create: if canUse()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 20;
      // A participant may add people and may leave (remove only themselves);
      // nobody can remove someone else or change who started it.
      allow update: if canUse()
        && request.auth.uid in resource.data.participants
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.participants.hasAll(resource.data.participants.removeAll([request.auth.uid]))
        && request.resource.data.participants.size() <= 20;
      allow delete: if false;

      // messages: { authorId, authorName, text, createdAt }. Readable and
      // writable only by current participants; you can delete only your own;
      // nothing is ever edited.
      match /messages/{msgId} {
        function inThread() {
          return request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        }
        allow read: if canUse() && inThread();
        allow create: if canUse() && inThread()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow delete: if canUse() && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Restricted notes ─────────────────────────────────────────
    // privateNotes/{id}: { authorId, authorName, viewers: [uid], viewerNames,
    //   sharedAt, target, targetKey, targetLabel, text, createdAt, updatedAt }
    // Visible only to `viewers` (which always includes the author). Only the
    // author can change the text or who can see it, or delete it.
    match /privateNotes/{noteId} {
      allow read: if canUse() && request.auth.uid in resource.data.viewers;
      allow create: if canUse()
        && request.resource.data.authorId == request.auth.uid
        && request.auth.uid in request.resource.data.viewers
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow update: if canUse()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.auth.uid in request.resource.data.viewers
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow delete: if canUse() && resource.data.authorId == request.auth.uid;
    }
  }
}
