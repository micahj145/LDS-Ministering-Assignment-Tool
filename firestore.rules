// ═══════════════════════════════════════════════════════════════
// Ministering Assignment Tool — Firestore security rules
//
// Deploy: firebase deploy --only firestore:rules
//
// Who gets in (final rules — see finalRules() below):
//   1. Their email is on the allowed list: allowedUsers/{lowercase email},
//      which only an admin can change. Default: no entry, no access.
//   2. They signed in with their password AND a code (text message or
//      authenticator app) — request.auth.token.firebase.sign_in_second_factor.
//   3. That sign-in was less than 14 days ago (auth_time).
//   4. Their email is verified.
// What they can change depends on their role on the allowed list:
//   eq / rs (EQ or RS presidency): member, household, move-in/out, identifier
//     and unit data; eq the brother assignment lists, rs the sister lists.
//   council (everyone else): notes, goals, next steps, Covenant Path Progress
//     (groups new / returning / mission), the tag directory, their own
//     profile (following, notification settings), messages.
//   Admin (admin: true on the allowed list) manages people; it adds no
//     ward-data editing rights.
//
// Two steps when switching this on:
//   Step 1 (finalRules() returns false): the new app is deployed with these
//     rules. People get in as before (approved profile) OR via the allowed
//     list + code. The app makes everyone set up their code at their next
//     sign-in, and moves notes into their own collection.
//   Step 2 (finalRules() returns true, a few days later): only the allowed
//     list + code + 14 days, and roles are enforced here.
// ═══════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Switch: false = step 1 (transition), true = step 2 (final) ──
    function finalRules() { return false; }

    function isSignedIn() { return request.auth != null; }
    function emailVerified() { return request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function myProfile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function allowPath() { return /databases/$(database)/documents/allowedUsers/$(myEmail()); }
    function onAllowList() { return isSignedIn() && request.auth.token.email is string && exists(allowPath()); }
    function access() { return get(allowPath()).data; }

    // Signed in with a password and a code, less than 14 days ago.
    function recentMfaLogin() {
      return isSignedIn()
        && ('sign_in_second_factor' in request.auth.token.firebase)
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(14, 'd');
    }
    function legacyApproved() { return isSignedIn() && myProfile().status == 'approved'; }

    // May read the ward data and use the app at all.
    function canUse() {
      return isSignedIn() && emailVerified() && (
        (onAllowList() && recentMfaLogin())
        || (!finalRules() && legacyApproved()));
    }
    function role() { return access().get('role', 'council'); }
    function presidency() { return finalRules() ? (onAllowList() && role() in ['eq', 'rs']) : true; }
    function isAdmin() {
      return isSignedIn() && (
        finalRules() ? (canUse() && access().get('admin', false) == true)
                     : ((onAllowList() && access().get('admin', false) == true) || myProfile().get('isAdmin', false) == true));
    }

    // Keep this in sync with ADMIN_EMAIL in ministering_tool.html.
    function isBootstrapAdminEmail() {
      return request.auth.token.email.lower() == 'micahj145@gmail.com';
    }

    // ── Allowed list ───────────────────────────────────────────
    // allowedUsers/{lowercase email}: { email, uid, role: eq|rs|council, admin, updatedAt, updatedBy }
    // You can read your own entry (the app takes your role from it); only an
    // admin can write. An admin can't take their own admin flag away or delete
    // themselves (that would lock everyone out of the Admin tab). The very
    // first admin entry is made by hand in the Firebase console.
    match /allowedUsers/{email} {
      allow read: if (isSignedIn() && emailVerified() && request.auth.token.email is string && myEmail() == email) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.role in ['eq', 'rs', 'council']
        && request.resource.data.admin is bool
        && !(email == myEmail() && request.resource.data.admin != true);
      allow delete: if isAdmin() && email != myEmail();
    }

    // adminData/callings: the Members with Callings check — names and callings
    // of people with access only. Admins only.
    match /adminData/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Profiles ───────────────────────────────────────────────
    match /profiles/{uid} {
      // You can read your own profile (even while pending/denied, so the
      // app can show you that status) — admins can read everyone's.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Self-registration immediately after signup: only your OWN doc,
      // and only with the exact status/isAdmin the app itself would set
      // (approved+admin only for the designated bootstrap email; pending
      // +non-admin for everyone else). This is what stops a client from
      // signing up and just writing status:'approved' or isAdmin:true.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','firstName','lastName','status','isAdmin','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == (isBootstrapAdminEmail() ? 'approved' : 'pending')
        && request.resource.data.isAdmin == isBootstrapAdminEmail();

      // Your own profile: names, following, notification settings — never
      // your own status, admin flag, email or role.
      allow update: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isAdmin', 'email', 'role']);

      // Admins approve/deny and can remove a profile.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── The shared ward data ───────────────────────────────────
    // An older copy of the app (one left open in a tab from before notes
    // moved out) writes the whole document without clientVersion; once the
    // new app has saved, those saves are refused.
    function fromCurrentApp() {
      return request.resource.data.get('clientVersion', 0) >= 2 || !('clientVersion' in resource.data);
    }
    function wardKeysFor(r) {
      return ['users', 'activityLog', 'updatedAt', 'updatedBy', 'updatedByUid', 'clientVersion', 'groups']
        .concat(r in ['eq', 'rs'] ? ['members', 'households', 'identMeta'] : [])
        .concat(r == 'eq' ? ['current', 'proposed'] : [])
        .concat(r == 'rs' ? ['currentRS', 'proposedRS'] : []);
    }
    function groupKeysFor(r) {
      return r in ['eq', 'rs'] ? ['new', 'returning', 'mission', 'movein', 'moveout'] : ['new', 'returning', 'mission'];
    }
    function allowedWardChange() {
      let r = role();
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let groups = request.resource.data.get('groups', {}).diff(resource.data.get('groups', {})).affectedKeys();
      return changed.hasOnly(wardKeysFor(r))
        && groups.hasOnly(groupKeysFor(r))
        && request.resource.data.get('updatedByUid', '') == request.auth.uid;
    }
    match /wardData/shared {
      allow read: if canUse();
      allow create: if canUse() && presidency();
      allow update: if canUse() && fromCurrentApp() && (!finalRules() || allowedWardChange());
      allow delete: if false;
    }

    // Unit Statistics tab: ward-level totals imported from LCR reports (no
    // names). Everyone reads; the presidencies import.
    match /wardData/stats {
      allow read: if canUse();
      allow write: if canUse() && presidency();
    }

    // ── Notes, goals and next steps ────────────────────────────
    // notes/{id}: { author, authorId, text, date, tags?, migrated?, target: { type, id, group?, field } }
    // Anyone with access adds their own and changes their own. The
    // presidencies may also change or remove others' (needed when a member or
    // household is removed), an admin may remove any, and anyone may remove
    // those on a Covenant Path Progress person (new / returning / mission),
    // since anyone may take a person off those lists.
    function validNote() {
      let d = request.resource.data;
      return d.text is string && d.text.size() <= 10000
        && d.target is map
        && d.target.type in ['member', 'household', 'current', 'proposed', 'currentRS', 'proposedRS', 'group']
        && d.target.field in ['notes', 'goals', 'nextSteps'];
    }
    function noteAuthor() { return resource.data.get('authorId', ''); }
    match /notes/{noteId} {
      allow read: if canUse();
      allow create: if canUse() && validNote()
        && (!finalRules() || request.resource.data.get('authorId', '') == request.auth.uid || presidency());
      allow update: if canUse() && validNote()
        && request.resource.data.get('authorId', '') == noteAuthor()
        && (!finalRules() || noteAuthor() == request.auth.uid || presidency());
      allow delete: if canUse() && (!finalRules()
        || noteAuthor() == '' || noteAuthor() == request.auth.uid || presidency() || isAdmin()
        || (resource.data.target.type == 'group' && resource.data.target.get('group', '') in ['new', 'returning', 'mission']));
    }

    // ── Direct messages ──────────────────────────────────────────
    // threads/{id}: { participants: [uid], names, createdBy, createdAt, lastAt, lastBy, lastByName }
    // Only the people in a conversation can see it or its messages — this
    // is the actual privacy, not just what the app chooses to show.
    match /threads/{threadId} {
      allow read: if canUse() && request.auth.uid in resource.data.participants;
      allow create: if canUse()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 20;
      // A participant may add people and may leave (remove only themselves);
      // nobody can remove someone else or change who started it.
      allow update: if canUse()
        && request.auth.uid in resource.data.participants
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.participants.hasAll(resource.data.participants.removeAll([request.auth.uid]))
        && request.resource.data.participants.size() <= 20;
      allow delete: if false;

      // messages: { authorId, authorName, text, createdAt }. Readable and
      // writable only by current participants; you can delete only your own;
      // nothing is ever edited.
      match /messages/{msgId} {
        function inThread() {
          return request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        }
        allow read: if canUse() && inThread();
        allow create: if canUse() && inThread()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow delete: if canUse() && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Restricted notes ─────────────────────────────────────────
    // privateNotes/{id}: { authorId, authorName, viewers: [uid], viewerNames,
    //   sharedAt, target, targetKey, targetLabel, text, createdAt, updatedAt }
    // Visible only to `viewers` (which always includes the author). Only the
    // author can change the text or who can see it, or delete it.
    match /privateNotes/{noteId} {
      allow read: if canUse() && request.auth.uid in resource.data.viewers;
      allow create: if canUse()
        && request.resource.data.authorId == request.auth.uid
        && request.auth.uid in request.resource.data.viewers
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow update: if canUse()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.auth.uid in request.resource.data.viewers
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow delete: if canUse() && resource.data.authorId == request.auth.uid;
    }
  }
}
